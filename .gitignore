# 上游只读参考源码，不纳入根仓库
/reference/

# 构建产物
/bin/
/dist/
/pbr
*.exe
*.test

# 本地凭据与运行时数据
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
/data/
/uploads/
/.uploads/
/tmp/
/spike/

# 编辑器与系统文件
.DS_Store
*.swp
*~

# 本地代理会话设置（主机本地权限配置，不入库）
.qoder/

# 验收原始运行日志与截图（含时间戳与请求细节，不入库；脱敏结论写 verify/**/README.md）
verify/**/*.log
verify/**/shots/

# 控制台构建产物（Docker/本地构建生成；仓库只保留 web/dist/index.html 占位页）
# 具体忽略规则以 web/.gitignore 为准（dist/* 但保留 dist/index.html）
/web/node_modules/

# 运行时日志目录（构建/启动产物）
/logs/

# Python 缓存（验收脚本运行产物，不入库）
__pycache__/
*.pyc
*.pyo
