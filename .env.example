# PowerBarRations docker compose 环境变量样例
#
# 用法：cp .env.example .env，然后替换所有 __REPLACE_*__ 占位符。
#   openssl rand -hex 32
# .env 已在 .gitignore / .dockerignore 中排除；请勿把真实值提交到仓库。

# ── 必填：会话签名与字段加密密钥 ───────────────────────────────────────────
# 两把必须是不同的随机值，各 64 位十六进制（openssl rand -hex 32 的输出）。
PBR_SESSION_SECRET=__REPLACE_WITH_openssl_rand_hex_32__
PBR_CRYPTO_SECRET=__REPLACE_WITH_openssl_rand_hex_32__

# ── 可选 ────────────────────────────────────────────────────────────────
# 对外端口与监听地址（默认 5700 / 0.0.0.0；只本机访问可改成 127.0.0.1）。
PBR_PORT=5700
PBR_BIND=0.0.0.0

# 镜像 tag / 构建时注入的版本号。
PBR_VERSION=dev

# 国内源为默认；海外网络可改用官方代理。
# PBR_GOPROXY=https://proxy.golang.org,direct

# 无头 / AI 部署可直接指定管理密钥，覆盖「登录口令派生」（token-spec v1 §2.4）。
# PBR_ADMIN_KEY=
# PBR_ADMIN_KEYS=

# 走外部反向代理终结 TLS 时，让会话 Cookie 带 Secure。
# 注意：SESSION_COOKIE_SECURE=true 必须与 SESSION_COOKIE_TRUSTED_URL 成对出现，
# 后者是逗号分隔的 https 站点源；只设前者会导致进程启动即退出。
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_TRUSTED_URL=https://pbr.example.com
